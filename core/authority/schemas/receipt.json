{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weaver Authority Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "envelope_id",
    "issuer",
    "subject",
    "claim",
    "evidence_level",
    "accepted",
    "reason",
    "payload_hash",
    "created_at",
    "receipt_hash"
  ],
  "properties": {
    "receipt_version": {
      "enum": [
        "weaver.authority.receipt.v1",
        "weaver.authority.receipt.v2"
      ]
    },
    "hash_profile": {
      "type": [
        "string",
        "null"
      ],
      "description": "v2: canonical-JSON profile the hash was computed under (core/authority/canonical.py). v1: absent or null."
    },
    "envelope_id": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_version": {
            "const": "weaver.authority.receipt.v2"
          }
        }
      },
      "then": {
        "required": [
          "hash_profile"
        ],
        "properties": {
          "hash_profile": {
            "enum": [
              "weaver.c14n.v1",
              "zorel.ascii.v1",
              "jcs.rfc8785"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_version": {
            "const": "weaver.authority.receipt.v1"
          }
        }
      },
      "then": {
        "properties": {
          "hash_profile": {
            "type": "null"
          }
        }
      }
    }
  ]
}
